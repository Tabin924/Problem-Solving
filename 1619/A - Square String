#define all(v) v.begin(), v.end()
 
void bankai(){
    string s;
    cin >> s;
    if(s.length() % 2 != 0){
        cout << "NO" << endl;
        return;
    }
    int a = s.length() / 2;
    string x, y;
    for(int i=0; i<a; i++){
        x.push_back(s[i]);
    }
    for(int i=a; i<s.length(); i++){
        y.push_back(s[i]);
    }
    if(x == y){
        cout << "YES" << endl;
    }
    else{
        cout << "NO" << endl;
    }
}
 
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t = 1;
    cin >> t;
    while (t--){
        bankai();
    }
    
    return 0;
}