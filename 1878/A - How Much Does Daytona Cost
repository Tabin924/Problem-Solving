#include <bits/stdc++.h>
using namespace std;
 
#define ll long long
#define all(v) v.begin(), v.end()
 
void bankai(){
    int n, k;
    cin >> n >> k;
    int flag = 1;
    for(int i=0; i<n; i++){
        int x;
        cin >> x;
        if(x == k && flag == 1){
            cout << "YES" << endl;
            flag = 0;
        }
    }
    if(flag){
        cout << "NO" << endl;
    }
}
 
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t = 1;
    cin >> t;
    while (t--){
        bankai();
    }
 
    return 0;
}